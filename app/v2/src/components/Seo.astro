---
// The head of every page: title and description, the canonical address,
// whether search engines may index it, the Open Graph and Twitter previews
// for links shared elsewhere, the favicon and the design tokens as CSS.
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { isoDay } from "../content/model";
import { absoluteUrl } from "../lib/seo";
import type { Site } from "../lib/site";
import { faviconHref, roleColor, tokenStylesheet, tokens } from "@design-system/tokens";

interface Props {
  site: Site;
  title: string;
  description: string;
  path: string | null;
  image?: ImageMetadata | undefined;
  imageAlt?: string | undefined;
  type?: "website" | "article";
  published?: Date | undefined;
}

const { site, title, description, path, image, imageAlt, type = "website", published } =
  Astro.props;
const { settings } = site;
// A page without its own address (404) is never indexed.
const indexed = settings.indexing && path !== null;
const share = await getImage({ src: image ?? settings.shareImage, width: 1200, format: "jpg" });
const shareUrl = absoluteUrl(settings.url, share.src);
const shareAlt = image ? (imageAlt ?? "") : settings.shareImageAlt;
const css = tokenStylesheet(tokens);
// The browser's frame takes the colour of the header in each theme.
const light = roleColor(tokens, "light", "surface-raised");
const dark = roleColor(tokens, "dark", "surface-raised");
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content={light} />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content={dark} />
<title>{title}</title>
<meta name="description" content={description} />
{path !== null && <link rel="canonical" href={absoluteUrl(settings.url, path)} />}
<meta name="robots" content={indexed ? "index, follow" : "noindex, nofollow"} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={settings.name} />
<meta property="og:locale" content={settings.locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{path !== null && <meta property="og:url" content={absoluteUrl(settings.url, path)} />}
<meta property="og:image" content={shareUrl} />
<meta property="og:image:width" content={String(share.attributes.width)} />
<meta property="og:image:height" content={String(share.attributes.height)} />
<meta property="og:image:alt" content={shareAlt} />
{published && <meta property="article:published_time" content={isoDay(published)} />}
<meta name="twitter:card" content="summary_large_image" />
<link rel="icon" href={faviconHref(tokens)} />
<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
<Fragment set:html={`<style>${css}</style>`} />
<script is:inline>
  // Without JavaScript the menu stays open (site.css); with it, it collapses
  // behind its button (MenuToggle of the design system).
  document.documentElement.classList.add("js");
</script>
