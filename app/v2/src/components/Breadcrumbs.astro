---
import type { Site } from "../lib/site";

interface Props {
  site: Site;
  items: { label: string; path: string }[];
  current: string;
}

const { site, items, current } = Astro.props;
---

<nav class="site-breadcrumbs" aria-label={site.texts.breadcrumbs}>
  <ol>
    {
      items.map((item) => (
        <li>
          <a href={item.path}>{item.label}</a>
        </li>
      ))
    }
    <li aria-current="page">{current}</li>
  </ol>
</nav>
