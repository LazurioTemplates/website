---
import { isoDay } from "../content/model";
import { formatDate } from "../lib/format";
import type { Site } from "../lib/site";

interface Props {
  site: Site;
  news: Site["news"];
}

const { site, news } = Astro.props;
---

{
  news.length === 0 ? (
    <p class="site-quiet">{site.texts.noNews}</p>
  ) : (
    <ul class="site-news" role="list">
      {news.map(({ entry, path }) => (
        <li class="site-news-item">
          <time datetime={isoDay(entry.data.date)}>
            {formatDate(entry.data.date, site.settings.locale)}
          </time>
          <div>
            <h3 class="site-news-title">
              <a href={path}>{entry.data.title}</a>
            </h3>
            <p>{entry.data.summary}</p>
          </div>
        </li>
      ))}
    </ul>
  )
}
