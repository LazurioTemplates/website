---
// A picture of the content, optimized at build: WebP in the widths a reader's
// screen needs, with its size declared so the page does not jump.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
}

const { src, alt } = Astro.props;
const widths = [...new Set([480, 720, 1440].map((width) => Math.min(width, src.width)))];
---

<figure class="site-figure">
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes="(max-width: 720px) 100vw, 720px"
    format="webp"
    loading="eager"
  />
</figure>
