---
import { telHref } from "../lib/format";
import type { Site } from "../lib/site";

interface Props {
  site: Site;
}

const { site } = Astro.props;
const { contacts } = site;
const t = site.texts;
---

<div class="site-grid">
  <section class="card" aria-labelledby="contact-address">
    <h2 id="contact-address" class="site-card-title">{t.address}</h2>
    <address>
      {contacts.address.street}<br />
      {contacts.address.postalCode}&nbsp;{contacts.address.city}<br />
      {contacts.address.country}
    </address>
  </section>
  <section class="card" aria-labelledby="contact-reach">
    <h2 id="contact-reach" class="site-card-title">{t.emailAndPhone}</h2>
    <p><a class="site-break" href={`mailto:${contacts.email}`}>{contacts.email}</a></p>
    <p><a href={telHref(contacts.phone)}>{contacts.phone}</a></p>
  </section>
  {
    contacts.hours.length > 0 && (
      <section class="card" aria-labelledby="contact-hours">
        <h2 id="contact-hours" class="site-card-title">
          {t.hours}
        </h2>
        <dl class="site-pairs">
          {contacts.hours.map((row) => (
            <div>
              <dt>{row.days}</dt>
              <dd>{row.time}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }
</div>

{
  contacts.people.length > 0 && (
    <section aria-labelledby="contact-people">
      <h2 id="contact-people">{t.people}</h2>
      <ul class="site-grid" role="list">
        {contacts.people.map((person) => (
          <li>
            <article class="card">
              <h3 class="site-card-title">{person.name}</h3>
              <p class="site-quiet">{person.role}</p>
              {person.email && (
                <p>
                  <a class="site-break" href={`mailto:${person.email}`}>
                    {person.email}
                  </a>
                </p>
              )}
              {person.phone && (
                <p>
                  <a href={telHref(person.phone)}>{person.phone}</a>
                </p>
              )}
            </article>
          </li>
        ))}
      </ul>
    </section>
  )
}

<section aria-labelledby="contact-company">
  <h2 id="contact-company">{t.companyDetails}</h2>
  <dl class="site-pairs site-company">
    <div><dt>{t.companyId}</dt><dd>{contacts.company.id}</dd></div>
    {contacts.company.vatId && <div><dt>{t.vatId}</dt><dd>{contacts.company.vatId}</dd></div>}
  </dl>
  {contacts.company.register && <p class="site-quiet">{contacts.company.register}</p>}
</section>
