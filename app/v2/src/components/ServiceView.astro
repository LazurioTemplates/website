---
import { render } from "astro:content";
import type { Site } from "../lib/site";
import Breadcrumbs from "design-system/astro/Breadcrumbs.astro";
import CallToAction from "./CallToAction.astro";
import ContentImage from "./ContentImage.astro";

interface Props {
  site: Site;
  entry: Site["services"][number]["entry"];
  list: Site["home"];
}

const { site, entry, list } = Astro.props;
const { data } = entry;
const t = site.texts;
const { Content } = await render(entry);
const cta = site.settings.callToAction;
---

<div class="site-container">
  <div class="site-breadcrumbs">
    <Breadcrumbs
      locale={site.language}
      items={[
        { label: t.home, href: "/" },
        { label: list.data.title, href: site.lists.services?.path ?? "/" },
        { label: data.title },
      ]}
    />
  </div>
  <header class="site-page-header">
    <h1 class="ds-type-display">{data.title}</h1>
    <p class="ds-type-lead">{data.summary}</p>
    {
      data.price && (
        <p class="site-price">
          {t.price}: {data.price}
        </p>
      )
    }
  </header>
  {data.image && data.imageAlt && <ContentImage src={data.image} alt={data.imageAlt} />}
  <div class="ds-prose">
    <Content />
  </div>
  {cta && <CallToAction site={site} cta={cta} />}
</div>
