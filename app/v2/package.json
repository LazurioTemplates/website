{
  "name": "website-app-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "prepare:app": "astro sync",
    "check:prepared": "bun run src/prepared.ts",
    "typecheck": "astro check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "validate:data": "bun run src/validate-data.ts",
    "check": "bun run typecheck && bun run lint && bun run validate:data && bun run test",
    "test": "bun test"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.6",
    "@lazurio/module-kit": "github:Lazurio/module-kit#v0.2.0",
    "astro": "7.4.5",
    "design-system": "github:LazurioTemplates/design-system#v2.0.0",
    "satteri": "0.10.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "typescript": "6.0.3"
  },
  "lazurio": {
    "runtime": {
      "schema_version": "lazurio.runtime.v1",
      "id": "replace-with-org-slug-website-v2",
      "title": "Website",
      "description": "The Organization website: pages, services, news and contacts, built as static files.",
      "company": "REPLACE-WITH-ORG-NAME",
      "module": "website",
      "surface": "internal",
      "dev_script": "dev",
      "build_script": "build",
      "build_output": "dist",
      "static_fallback": "404",
      "tags": [
        "website",
        "content"
      ],
      "listeners": [
        {
          "id": "app",
          "role": "entrypoint",
          "lease": "main",
          "protocol": "http",
          "health": {
            "kind": "http",
            "path": "/"
          }
        }
      ]
    },
    "preparation": {
      "schema_version": "lazurio.preparation.v1",
      "owner_package": "app/v2/package.json",
      "prepare_script": "prepare:app",
      "check_script": "check:prepared"
    }
  }
}
